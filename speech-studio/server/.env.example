# Microsoft Azure AI Speech Service / Microsoft Foundry Configuration
# Option 1: Microsoft Foundry Endpoint (Recommended for Azure AI Foundry / Multi-Service Cognitive Services)
AZURE_SPEECH_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_SPEECH_KEY=your_speech_or_foundry_api_key

# Option 2: Regional Azure Speech Service
# NOTE: Set the exact Azure region where the resource is deployed (e.g. southeastasia, eastus, westeurope)
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_KEY=your_azure_speech_key

# Server & CORS Configuration
PORT=5000
CLIENT_URL=https://multilanguage-1.onrender.com
