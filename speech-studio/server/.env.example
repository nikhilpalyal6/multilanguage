# Microsoft Azure AI Speech Service / Microsoft Foundry Configuration
# Option 1: Microsoft Foundry Endpoint (Recommended for Foundry resources)
FOUNDRY_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
FOUNDRY_API_KEY=your_foundry_api_key
FOUNDRY_MODEL=Azure-Speech-Text-to-speech

# Option 2: Standard Azure Speech Subscription Key & Region
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region

PORT=5000
